// Munchkin: a long, low tabby loaf on tiny legs. Units are roughly head
// radii; the floor is at y = -1.1, +z faces the camera.
(
    species: "munchkin",
    slots: ["fur", "light", "stripe", "ear", "eye", "ink", "nose", "blush"],
    coats: [
        (name: "milktea", colors: {
            "fur": "#D9B48F", "light": "#FFF6EA", "stripe": "#B88E66", "ear": "#F6C3B8",
            "eye": "#3B2A22", "ink": "#3B2A22", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "orange", colors: {
            "fur": "#F0A35E", "light": "#FFF4E6", "stripe": "#D9823C", "ear": "#F8C4B0",
            "eye": "#3B2A22", "ink": "#3B2A22", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "grey", colors: {
            "fur": "#A9ADB5", "light": "#F2F3F5", "stripe": "#868A93", "ear": "#F2C4C8",
            "eye": "#2F3142", "ink": "#2F3142", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "black", colors: {
            "fur": "#3F3A3A", "light": "#6E6767", "stripe": "#2A2626", "ear": "#8A6F70",
            "eye": "#E8C14A", "ink": "#1E1A1A", "nose": "#E8949E", "blush": "#FF9AA6",
        }),
    ],
    pivots: {
        "body": (0, -1.1, 0),
        "head": (0, 0, 0.05),
        "front_legs": (0, -0.78, 0.5),
        "back_legs": (0, -0.9, 0),
        "tail": (0.4, -0.9, -0.85),
    },
    parts: [
        (name: "body", bone: "body", shape: Ellipsoid((0.88, 0.56, 0.82)), at: (0, -0.54, -0.05),
            color: "fur", chonk: 1.0, zone: "bottom",
            marks: [
                (at: (0, 0.0, 0.72), radii: (0.46, 0.6, 0.55), color: "light", soft: 0.25, zone: Some("belly")),
                // Tabby bands across the back.
                (at: (0, 0.32, -0.55), radii: (1.2, 0.06, 0.55), color: "stripe", soft: 0.6),
                (at: (0, 0.1, -0.6), radii: (1.2, 0.06, 0.55), color: "stripe", soft: 0.6),
                (at: (0, -0.12, -0.6), radii: (1.2, 0.06, 0.55), color: "stripe", soft: 0.6),
            ]),
        (name: "head", bone: "head", shape: Ellipsoid((1.0, 0.82, 0.86)), at: (0, 0.42, 0.1),
            blend: 0.22, color: "fur", zone: "head",
            marks: [
                (at: (0, -0.5, 0.55), radii: (0.62, 0.42, 0.55), color: "light", soft: 0.3),
                (at: (0.52, -0.15, 0.6), radii: (0.3, 0.25, 0.3), color: "fur", soft: 0.4, zone: Some("cheek"), mirror: true),
                // The tabby M on the forehead.
                (at: (0, 0.6, 0.6), radii: (0.045, 0.17, 0.4), color: "stripe", soft: 0.5),
                (at: (0.2, 0.56, 0.62), radii: (0.04, 0.15, 0.4), color: "stripe", soft: 0.5, mirror: true),
                (at: (0.62, 0.15, 0.4), radii: (0.25, 0.04, 0.5), color: "stripe", soft: 0.5, mirror: true),
