        (name: "cheek", parts: ["muzzle"]),
        (name: "paw", parts: ["foot_fl", "foot_fr"]),
        (name: "head", parts: ["head", "ear_l", "ear_r"]),
        (name: "bottom", parts: ["body", "tail", "foot_bl", "foot_br"]),
