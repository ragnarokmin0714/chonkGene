// Munchkin rig. Part ids are element ids in standard.svg / mochi.svg,
// listed back to front. Compile with `cargo xtask art`.
(
    species: "munchkin",
    size: (200, 184),
    ground_y: 176,
    slots: ["shadow", "fur_main", "fur_light", "stripe", "ear_inner", "eye", "ink", "white", "nose", "blush"],
    coats: [
        (name: "milktea", colors: {
            "shadow": "#3B2A2217", "fur_main": "#D9B48F", "fur_light": "#FFF6EA", "stripe": "#B88E66", "ear_inner": "#F6C3B8",
            "eye": "#3B2A22", "ink": "#3B2A22", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "orange", colors: {
            "shadow": "#3B2A2217", "fur_main": "#F0A35E", "fur_light": "#FFF4E6", "stripe": "#D9823C", "ear_inner": "#F8C4B0",
            "eye": "#3B2A22", "ink": "#3B2A22", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "grey", colors: {
            "shadow": "#3B2A2217", "fur_main": "#A9ADB5", "fur_light": "#F2F3F5", "stripe": "#868A93", "ear_inner": "#F2C4C8",
            "eye": "#2F3142", "ink": "#2F3142", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "black", colors: {
            "shadow": "#3B2A2217", "fur_main": "#3F3A3A", "fur_light": "#6E6767", "stripe": "#2A2626", "ear_inner": "#8A6F70",
            "eye": "#E8C14A", "ink": "#1E1A1A", "white": "#FFFFFF", "nose": "#E8949E", "blush": "#F2A0AA99",
        }),
    ],
    bones: [
        (name: "root", parent: None, pivot: (100, 176)),
        (name: "body", parent: Some("root"), pivot: (100, 176)),
        (name: "belly", parent: Some("body"), pivot: (100, 152)),
        (name: "tail", parent: Some("body"), pivot: (152, 152)),
        (name: "head", parent: Some("root"), pivot: (100, 128)),
        (name: "eye_l", parent: Some("head"), pivot: (80, 88)),
        (name: "eye_r", parent: Some("head"), pivot: (120, 88)),
    ],
    parts: [
        (id: "shadow", bone: "root", slot: "shadow"),
        (id: "tail", bone: "tail", slot: "fur_main"),
        (id: "body", bone: "body", slot: "fur_main"),
        (id: "belly", bone: "belly", slot: "fur_light"),
        (id: "foot_bl", bone: "body", slot: "fur_light"),
        (id: "foot_fl", bone: "body", slot: "fur_light"),
        (id: "foot_fr", bone: "body", slot: "fur_light"),
        (id: "foot_br", bone: "body", slot: "fur_light"),
        (id: "ear_l", bone: "head", slot: "fur_main"),
        (id: "ear_r", bone: "head", slot: "fur_main"),
        (id: "ear_inner_l", bone: "head", slot: "ear_inner"),
        (id: "ear_inner_r", bone: "head", slot: "ear_inner"),
        (id: "head", bone: "head", slot: "fur_main"),
        (id: "stripes", bone: "head", slot: "stripe"),
        (id: "muzzle", bone: "head", slot: "fur_light"),
        (id: "eye_l", bone: "eye_l", slot: "eye"),
        (id: "eye_r", bone: "eye_r", slot: "eye"),
        (id: "eye_hl_l", bone: "eye_l", slot: "white"),
