// Owl: one round egg with a face disc, ear tufts, big yellow eyes and a tiny
// beak. No neck, no visible legs: just toes. Units are roughly head radii;
// the floor is at y = -1.1, +z faces the camera.
// The same bird as model.ron for the skinned mesh: a bone for each leg and
// wing, so the legs step in turn and the wings swing on their own.
(
    species: "owl",
    slots: ["feather", "belly", "wing", "scallop", "disc", "ring", "eye", "beak", "blush"],
    coats: [
        (name: "brown", colors: {
            "feather": "#A9785A", "belly": "#F3E3CF", "wing": "#8F6246", "scallop": "#D9BFA3",
            "disc": "#F6E7D2", "ring": "#F2C94C", "eye": "#2F2420", "beak": "#F2B24C", "blush": "#FF9AA6",
        }),
        (name: "snowy", colors: {
            "feather": "#E9E6DF", "belly": "#FFFFFF", "wing": "#D5D0C6", "scallop": "#C9C3B7",
            "disc": "#FFFFFF", "ring": "#F2C94C", "eye": "#2F2420", "beak": "#4A4540", "blush": "#FF9AA6",
        }),
        (name: "grey", colors: {
            "feather": "#8E8C94", "belly": "#E4E2E8", "wing": "#75737B", "scallop": "#B8B6BE",
            "disc": "#ECEAF0", "ring": "#F2C94C", "eye": "#2A2830", "beak": "#F2B24C", "blush": "#FF9AA6",
        }),
    ],
    pivots: {
        "body": (0, -1.1, 0),
        "head": (0, 0.1, 0),
        "leg_l": (0.27, -0.82, 0.5),
        "leg_r": (-0.27, -0.82, 0.5),
        "wing_l": (0.78, 0.25, -0.05),
        "wing_r": (-0.78, 0.25, -0.05),
        "tail": (0, -0.92, -0.62),
    },
    // Everything hangs from the body, so a waddle carries head, wings and
    // legs along.
    // The body carries the head, the wings and the tail; the legs hang from
    // the whole pet, so a planted foot stays on the floor as the body rolls.
    parents: {
        "head": "body",
        "wing_l": "body",
        "wing_r": "body",
        "tail": "body",
    },
    // Soft spots that wobble: the round belly, the bottom, the chin.
    jiggles: [
        (name: "belly", parent: "body", at: (0, -0.5, 0.45), radius: 0.55, share: 0.85),
        (name: "butt", parent: "body", at: (0, -0.5, -0.7), radius: 0.5, share: 0.8),
        (name: "chin", parent: "head", at: (0, -0.1, 0.7), radius: 0.45, share: 0.8),
    ],
    parts: [
        (name: "body", bone: "body", shape: Ellipsoid((0.92, 0.82, 0.82)), at: (0, -0.3, 0),
            color: "feather", chonk: 1.0, zone: "bottom",
            marks: [
                (at: (0, -0.05, 0.6), radii: (0.6, 0.75, 0.5), color: "belly", soft: 0.3, zone: Some("belly")),
                // Scalloped breast feathers.
                (at: (0, 0.18, 0.78), radii: (0.09, 0.05, 0.2), color: "scallop", soft: 0.5),
                (at: (0.25, 0.0, 0.76), radii: (0.09, 0.05, 0.2), color: "scallop", soft: 0.5, mirror: true),
                (at: (0, -0.2, 0.8), radii: (0.09, 0.05, 0.2), color: "scallop", soft: 0.5),
                (at: (0.27, -0.38, 0.72), radii: (0.09, 0.05, 0.2), color: "scallop", soft: 0.5, mirror: true),
            ]),
        // The head melts into the body: owls have no neck to speak of.
        (name: "head", bone: "head", shape: Ellipsoid((0.94, 0.74, 0.82)), at: (0, 0.5, 0.04),
            blend: 0.45, color: "feather", zone: "head",
            marks: [
                // The face disc: two pale rounds around the eyes.
                (at: (0.33, -0.02, 0.62), radii: (0.38, 0.4, 0.4), color: "disc", soft: 0.25, mirror: true),
                (at: (0.6, -0.25, 0.5), radii: (0.22, 0.2, 0.3), color: "disc", soft: 0.4, zone: Some("cheek"), mirror: true),
            ]),
        (name: "tuft", bone: "head", shape: Cone(r1: 0.17, r2: 0.04, h: 0.32, flat: 2.0), at: (0.52, 1.06, 0.0),
            rot: (-8, 0, -30), blend: 0.12, color: "feather", mirror: true, zone: "head"),
        (name: "wing_l", bone: "wing_l", shape: Ellipsoid((0.2, 0.55, 0.42)), at: (0.86, -0.25, -0.05),
            rot: (0, 0, 10), blend: 0.08, color: "wing", chonk: 0.7, zone: "bottom",
            marks: [(at: (0.1, -0.35, 0), radii: (0.3, 0.12, 0.5), color: "scallop", soft: 0.6)]),
        (name: "wing_r", bone: "wing_r", shape: Ellipsoid((0.2, 0.55, 0.42)), at: (-0.86, -0.25, -0.05),
            rot: (0, -0, -10), blend: 0.08, color: "wing", chonk: 0.7, zone: "bottom",
            marks: [(at: (0.1, -0.35, 0), radii: (0.3, 0.12, 0.5), color: "scallop", soft: 0.6)]),
        (name: "tail", bone: "tail", shape: Ellipsoid((0.3, 0.14, 0.25)), at: (0, -0.95, -0.72),
            rot: (-25, 0, 0), blend: 0.08, color: "wing", zone: "bottom"),
        // Short feathered legs from the hips to the toes, so the toes stay on
        // as they step.
        (name: "leg_l", bone: "leg_l", shape: Capsule(to: (0.0, -0.17, 0.08), r: 0.075), at: (0.27, -0.82, 0.5),
            blend: 0.06, color: "feather", chonk: 0.6, zone: "paw"),
        (name: "leg_r", bone: "leg_r", shape: Capsule(to: (0.0, -0.17, 0.08), r: 0.075), at: (-0.27, -0.82, 0.5),
            blend: 0.06, color: "feather", chonk: 0.6, zone: "paw"),
        (name: "toe_l", bone: "leg_l", shape: Ellipsoid((0.07, 0.06, 0.13)), at: (0.22, -1.04, 0.62),
            blend: 0.03, color: "beak", fuzz: 0.0, chonk: 0.6, zone: "paw"),
        (name: "toe_r", bone: "leg_r", shape: Ellipsoid((0.07, 0.06, 0.13)), at: (-0.22, -1.04, 0.62),
            blend: 0.03, color: "beak", fuzz: 0.0, chonk: 0.6, zone: "paw"),
        (name: "toe_out_l", bone: "leg_l", shape: Ellipsoid((0.07, 0.06, 0.12)), at: (0.36, -1.04, 0.56),
            rot: (0, 25, 0), blend: 0.03, color: "beak", fuzz: 0.0, chonk: 0.6, zone: "paw"),
        (name: "toe_out_r", bone: "leg_r", shape: Ellipsoid((0.07, 0.06, 0.12)), at: (-0.36, -1.04, 0.56),
            rot: (0, -25, -0), blend: 0.03, color: "beak", fuzz: 0.0, chonk: 0.6, zone: "paw"),
        (name: "beak", bone: "head", shape: Cone(r1: 0.09, r2: 0.025, h: 0.2, flat: 1.4), at: (0, 0.44, 0.84),
            rot: (150, 0, 0), blend: 0.03, color: "beak", gloss: 0.5, fuzz: 0.0, zone: "head"),
    ],
    // Two legs in turn; the body sways rather than twists, the head bobs.
    // Two legs in turn (degrees of swing, world units of lift); the body rolls
    // onto the planted leg by `roll` degrees, the head nods `nod`.
    gait: (swing: 22, lift: 0.06, roll: 5, twist: 0, nod: 3, diagonal: false),
    face: (
        on: "head",
        nose: (0.14, -0.15, 0.85),
        ink: "eye",
        eye: (at: (0.34, 0.0), r: (0.17, 0.18), iris: Some(("ring", 0.58))),
        blush: (at: (0.6, -0.3), r: (0.12, 0.07), color: "blush"),
    ),
)
