// Owl rig. Part ids are element ids in standard.svg / mochi.svg, listed
// back to front. Compile with `cargo xtask art`.
(
    species: "owl",
    size: (200, 184),
    ground_y: 176,
    slots: ["shadow", "feather", "wing", "belly", "scallop", "disc", "eye_ring", "eye", "white", "beak", "blush"],
    coats: [
        (name: "brown", colors: {
            "shadow": "#3B2A2217", "feather": "#A9785A", "wing": "#8F6246", "belly": "#F3E3CF", "scallop": "#D9BFA3",
            "disc": "#F6E7D2", "eye_ring": "#F2C94C", "eye": "#2F2420", "white": "#FFFFFF", "beak": "#F2B24C", "blush": "#F2A0AA99",
        }),
        (name: "snowy", colors: {
            "shadow": "#3B2A2217", "feather": "#E9E6DF", "wing": "#D5D0C6", "belly": "#FFFFFF", "scallop": "#C9C3B7",
            "disc": "#FFFFFF", "eye_ring": "#F2C94C", "eye": "#2F2420", "white": "#FFFFFF", "beak": "#4A4540", "blush": "#F2A0AA99",
        }),
        (name: "grey", colors: {
            "shadow": "#3B2A2217", "feather": "#8E8C94", "wing": "#75737B", "belly": "#E4E2E8", "scallop": "#B8B6BE",
            "disc": "#ECEAF0", "eye_ring": "#F2C94C", "eye": "#2A2830", "white": "#FFFFFF", "beak": "#F2B24C", "blush": "#F2A0AA99",
        }),
    ],
    bones: [
        (name: "root", parent: None, pivot: (100, 176)),
        (name: "body", parent: Some("root"), pivot: (100, 174)),
        (name: "belly", parent: Some("body"), pivot: (100, 136)),
        (name: "head", parent: Some("root"), pivot: (100, 112)),
        (name: "eye_l", parent: Some("head"), pivot: (78, 86)),
        (name: "eye_r", parent: Some("head"), pivot: (122, 86)),
    ],
    parts: [
        (id: "shadow", bone: "root", slot: "shadow"),
        (id: "tuft_l", bone: "head", slot: "feather"),
        (id: "tuft_r", bone: "head", slot: "feather"),
        (id: "body", bone: "body", slot: "feather"),
        (id: "wing_l", bone: "body", slot: "wing"),
        (id: "wing_r", bone: "body", slot: "wing"),
        (id: "belly", bone: "belly", slot: "belly"),
        (id: "scallops", bone: "belly", slot: "scallop"),
        (id: "foot_l", bone: "body", slot: "beak"),
        (id: "foot_r", bone: "body", slot: "beak"),
        (id: "disc_l", bone: "head", slot: "disc"),
        (id: "disc_r", bone: "head", slot: "disc"),
        (id: "ring_l", bone: "eye_l", slot: "eye_ring"),
        (id: "ring_r", bone: "eye_r", slot: "eye_ring"),
        (id: "eye_l", bone: "eye_l", slot: "eye"),
        (id: "eye_r", bone: "eye_r", slot: "eye"),
        (id: "eye_hl_l", bone: "eye_l", slot: "white"),
        (id: "eye_hl_r", bone: "eye_r", slot: "white"),
        (id: "beak", bone: "head", slot: "beak"),
        (id: "blush_l", bone: "head", slot: "blush"),
        (id: "blush_r", bone: "head", slot: "blush"),
    ],
    zones: [
        (name: "belly", parts: ["belly"]),
        (name: "cheek", parts: ["disc_l", "disc_r"]),
        (name: "paw", parts: ["foot_l", "foot_r", "wing_l", "wing_r"]),
        (name: "head", parts: ["tuft_l", "tuft_r"]),
        (name: "bottom", parts: ["body"]),
    ],
    anchors: {
