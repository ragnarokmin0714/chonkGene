// Duckling rig. Part ids are element ids in standard.svg / mochi.svg,
// listed back to front. Compile with `cargo xtask art`.
(
    species: "duck",
    size: (200, 184),
    ground_y: 176,
    slots: ["shadow", "outline", "feather", "belly", "wing", "eye", "white", "bill", "bill_light", "blush"],
    coats: [
        (name: "white", colors: {
            "shadow": "#3B2A2217", "outline": "#E2DAD0", "feather": "#FFFFFF", "belly": "#F6F2EC", "wing": "#F3EEE7",
            "eye": "#3B2A22", "white": "#FFFFFF", "bill": "#F29B38", "bill_light": "#F7B955", "blush": "#F7A9A0BF",
        }),
        (name: "yellow", colors: {
            "shadow": "#3B2A2217", "outline": "#E8C35A", "feather": "#FFE07A", "belly": "#FFF1B8", "wing": "#F5D060",
            "eye": "#3B2A22", "white": "#FFFFFF", "bill": "#F29B38", "bill_light": "#F7B955", "blush": "#F7A9A0BF",
        }),
        (name: "grey", colors: {
            "shadow": "#3B2A2217", "outline": "#A9AEB6", "feather": "#C9CDD3", "belly": "#E8EBEE", "wing": "#B6BBC3",
            "eye": "#2F3142", "white": "#FFFFFF", "bill": "#E8952F", "bill_light": "#F2B24C", "blush": "#F7A9A0BF",
        }),
    ],
    bones: [
        (name: "root", parent: None, pivot: (100, 176)),
        (name: "body", parent: Some("root"), pivot: (100, 172)),
        (name: "belly", parent: Some("body"), pivot: (104, 142)),
        (name: "tail", parent: Some("body"), pivot: (148, 112)),
        (name: "head", parent: Some("root"), pivot: (100, 112)),
        (name: "eye_l", parent: Some("head"), pivot: (84, 70)),
        (name: "eye_r", parent: Some("head"), pivot: (116, 70)),
    ],
    parts: [
        (id: "shadow", bone: "root", slot: "shadow"),
        (id: "feet", bone: "root", slot: "bill"),
        (id: "tail", bone: "tail", slot: "feather"),
        (id: "body_line", bone: "body", slot: "outline"),
        (id: "body", bone: "body", slot: "feather"),
        (id: "belly", bone: "belly", slot: "belly"),
        (id: "wing", bone: "body", slot: "wing"),
        (id: "head_line", bone: "head", slot: "outline"),
        (id: "head", bone: "head", slot: "feather"),
        (id: "tuft", bone: "head", slot: "outline"),
        (id: "eye_l", bone: "eye_l", slot: "eye"),
        (id: "eye_r", bone: "eye_r", slot: "eye"),
        (id: "eye_hl_l", bone: "eye_l", slot: "white"),
        (id: "eye_hl_r", bone: "eye_r", slot: "white"),
        (id: "bill", bone: "head", slot: "bill"),
        (id: "bill_top", bone: "head", slot: "bill_light"),
        (id: "blush_l", bone: "head", slot: "blush"),
        (id: "blush_r", bone: "head", slot: "blush"),
    ],
    zones: [
        (name: "belly", parts: ["belly"]),
        (name: "cheek", parts: ["blush_l", "blush_r", "bill"]),
        (name: "paw", parts: ["feet", "wing"]),
        (name: "head", parts: ["head", "head_line", "tuft"]),
        (name: "bottom", parts: ["body", "body_line", "tail"]),
    ],
    anchors: {
        "bubble": (100, 26),
    },
)
