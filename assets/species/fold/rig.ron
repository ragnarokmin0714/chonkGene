// Scottish Fold rig. Part ids are element ids in standard.svg / mochi.svg,
// listed back to front. Compile with `cargo xtask art`.
(
    species: "fold",
    size: (200, 184),
    ground_y: 176,
    slots: ["shadow", "fur_main", "fur_light", "stripe", "eye", "ink", "white", "nose", "blush"],
    coats: [
        (name: "bluegrey", colors: {
            "shadow": "#2F314217", "fur_main": "#B8BED6", "fur_light": "#EEF0F8", "stripe": "#8F96B8",
            "eye": "#2F3142", "ink": "#2F3142", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "cream", colors: {
            "shadow": "#2F314217", "fur_main": "#F1D9B5", "fur_light": "#FFF7EA", "stripe": "#D9B88C",
            "eye": "#2F3142", "ink": "#2F3142", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "silver", colors: {
            "shadow": "#2F314217", "fur_main": "#CFD3D8", "fur_light": "#F5F6F8", "stripe": "#8E959E",
            "eye": "#2F3142", "ink": "#2F3142", "white": "#FFFFFF", "nose": "#F2A0AA", "blush": "#F2A0AAB3",
        }),
        (name: "black", colors: {
            "shadow": "#2F314217", "fur_main": "#4B4A55", "fur_light": "#7D7C8A", "stripe": "#34333D",
            "eye": "#E8C14A", "ink": "#1E1E24", "white": "#FFFFFF", "nose": "#E8949E", "blush": "#F2A0AA99",
        }),
    ],
    bones: [
        (name: "root", parent: None, pivot: (100, 176)),
        (name: "body", parent: Some("root"), pivot: (100, 174)),
        (name: "belly", parent: Some("body"), pivot: (100, 142)),
        (name: "tail", parent: Some("body"), pivot: (146, 168)),
        (name: "head", parent: Some("root"), pivot: (100, 120)),
        (name: "eye_l", parent: Some("head"), pivot: (80, 78)),
        (name: "eye_r", parent: Some("head"), pivot: (120, 78)),
    ],
    parts: [
        (id: "shadow", bone: "root", slot: "shadow"),
        (id: "tail", bone: "tail", slot: "fur_main"),
        (id: "body", bone: "body", slot: "fur_main"),
        (id: "belly", bone: "belly", slot: "fur_light"),
        (id: "paw_fl", bone: "body", slot: "fur_light"),
        (id: "paw_fr", bone: "body", slot: "fur_light"),
        (id: "ear_l", bone: "head", slot: "fur_main"),
        (id: "ear_r", bone: "head", slot: "fur_main"),
        (id: "ear_fold_l", bone: "head", slot: "stripe"),
        (id: "ear_fold_r", bone: "head", slot: "stripe"),
        (id: "head", bone: "head", slot: "fur_main"),
        (id: "stripes", bone: "head", slot: "stripe"),
        (id: "muzzle", bone: "head", slot: "fur_light"),
        (id: "eye_l", bone: "eye_l", slot: "eye"),
        (id: "eye_r", bone: "eye_r", slot: "eye"),
        (id: "eye_hl_l", bone: "eye_l", slot: "white"),
        (id: "eye_hl_r", bone: "eye_r", slot: "white"),
        (id: "nose", bone: "head", slot: "nose"),
        (id: "mouth", bone: "head", slot: "ink"),
        (id: "whiskers", bone: "head", slot: "stripe"),
        (id: "blush_l", bone: "head", slot: "blush"),
        (id: "blush_r", bone: "head", slot: "blush"),
    ],
    zones: [
        (name: "belly", parts: ["belly"]),
        (name: "cheek", parts: ["muzzle"]),
        (name: "paw", parts: ["paw_fl", "paw_fr"]),
        (name: "head", parts: ["head", "ear_l", "ear_r"]),
        (name: "bottom", parts: ["body", "tail"]),
    ],
    anchors: {
        "bubble": (100, 22),
    },
)
