// Scottish Fold: an owl-round face, ears folded flat forward, big round eyes,
// a thick tail curled round the front paws. Units are roughly head radii;
// the floor is at y = -1.1, +z faces the camera.
(
    species: "fold",
    slots: ["fur", "light", "stripe", "eye", "ink", "nose", "blush"],
    coats: [
        (name: "bluegrey", colors: {
            "fur": "#B8BED6", "light": "#EEF0F8", "stripe": "#8F96B8",
            "eye": "#2F3142", "ink": "#2F3142", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "cream", colors: {
            "fur": "#F1D9B5", "light": "#FFF7EA", "stripe": "#D9B88C",
            "eye": "#2F3142", "ink": "#2F3142", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "silver", colors: {
            "fur": "#CFD3D8", "light": "#F5F6F8", "stripe": "#8E959E",
            "eye": "#2F3142", "ink": "#2F3142", "nose": "#F2A0AA", "blush": "#FF9AA6",
        }),
        (name: "black", colors: {
            "fur": "#4B4A55", "light": "#7D7C8A", "stripe": "#34333D",
            "eye": "#E8C14A", "ink": "#1E1E24", "nose": "#E8949E", "blush": "#FF9AA6",
        }),
    ],
    pivots: {
        "body": (0, -1.1, 0),
        "head": (0, 0, 0.05),
        "front_legs": (0, -0.66, 0.5),
        "back_legs": (0, -0.86, 0),
        "tail": (-0.8, -0.95, -0.3),
    },
    parts: [
        (name: "body", bone: "body", shape: Ellipsoid((0.9, 0.66, 0.84)), at: (0, -0.44, -0.02),
            color: "fur", chonk: 1.0, zone: "bottom",
            marks: [
                (at: (0, 0.05, 0.72), radii: (0.48, 0.66, 0.55), color: "light", soft: 0.3, zone: Some("belly")),
                (at: (0, 0.3, -0.6), radii: (1.2, 0.07, 0.55), color: "stripe", soft: 0.7),
                (at: (0, 0.02, -0.65), radii: (1.2, 0.07, 0.55), color: "stripe", soft: 0.7),
            ]),
        // A wide, flat-topped round head: the fold's teddy-bear face.
        (name: "head", bone: "head", shape: Ellipsoid((1.06, 0.86, 0.88)), at: (0, 0.5, 0.08),
            blend: 0.24, color: "fur", zone: "head",
            marks: [
                (at: (0, -0.5, 0.55), radii: (0.6, 0.42, 0.55), color: "light", soft: 0.35),
                (at: (0.55, -0.15, 0.6), radii: (0.3, 0.25, 0.3), color: "fur", soft: 0.4, zone: Some("cheek"), mirror: true),
                (at: (0, 0.66, 0.5), radii: (0.04, 0.16, 0.45), color: "stripe", soft: 0.6),
                (at: (0.19, 0.62, 0.52), radii: (0.035, 0.14, 0.45), color: "stripe", soft: 0.6, mirror: true),
            ]),
        (name: "muzzle", bone: "head", shape: Ellipsoid((0.3, 0.18, 0.2)), at: (0, 0.24, 0.82),
            blend: 0.14, color: "light", zone: "head"),
        // Folded ears: small flaps lying forward against the head.
        (name: "ear", bone: "head", shape: Cone(r1: 0.22, r2: 0.07, h: 0.26, flat: 2.2), at: (0.46, 1.2, 0.12),
            rot: (105, 0, -25), blend: 0.07, color: "fur",
            marks: [(at: (0, 0.2, 0), radii: (0.3, 0.2, 0.3), color: "stripe", soft: 0.8)], mirror: true, zone: "head"),
        (name: "front_leg", bone: "front_legs", shape: Capsule(to: (0.0, -0.32, 0.05), r: 0.16), at: (0.3, -0.66, 0.52),
            blend: 0.1, color: "fur", chonk: 0.3, mirror: true, zone: "paw",
            marks: [(at: (0, -0.32, 0.05), radii: (0.2, 0.12, 0.2), color: "light", soft: 0.3)]),
        (name: "haunch", bone: "back_legs", shape: Ellipsoid((0.3, 0.26, 0.34)), at: (0.62, -0.86, -0.02),
            blend: 0.12, color: "fur", chonk: 1.0, mirror: true, zone: "bottom"),
        (name: "foot", bone: "back_legs", shape: Ellipsoid((0.15, 0.09, 0.21)), at: (0.62, -1.03, 0.36),
            blend: 0.1, color: "light", chonk: 1.0, mirror: true, zone: "paw"),
        // A thick tail wrapped round to the front.
        (name: "tail", bone: "tail", shape: Capsule(to: (0.05, 0.0, 0.65), r: 0.14), at: (-0.8, -0.95, -0.3),
            blend: 0.08, color: "fur", chonk: 0.5, zone: "bottom",
            marks: [(at: (0.03, 0, 0.4), radii: (0.3, 0.3, 0.07), color: "stripe", soft: 0.6)]),
        (name: "tail_tip", bone: "tail", shape: Capsule(to: (0.38, 0.0, 0.25), r: 0.13), at: (-0.75, -0.94, 0.35),
            blend: 0.08, color: "stripe", chonk: 0.5, zone: "bottom"),
        (name: "nose", bone: "head", shape: Ellipsoid((0.07, 0.05, 0.05)), at: (0, 0.35, 0.99),
            blend: 0.02, color: "nose", gloss: 0.6, fuzz: 0.0, zone: "head"),
    ],
    face: (
        on: "head",
        mouth_on: Some("muzzle"),
        nose: (0.14, -0.2, 0.92),
        ink: "ink",
        // Big, round, a little low: the fold's owlish look.
        eye: (at: (0.35, 0.02), r: (0.13, 0.14), iris: Some(("eye", 0.7))),
        blush: (at: (0.56, -0.18), r: (0.13, 0.08), color: "blush"),
        whiskers: true,
    ),
)
