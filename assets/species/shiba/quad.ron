            blend: 0.16, color: "fur", chonk: 1.0, zone: "bottom"),
        (name: "leg_bl", bone: "leg_bl", shape: Capsule(to: (0, -0.38, 0.05), r: 0.15), at: (0.3, -0.57, -0.6),
            blend: 0.12, color: "fur", chonk: 0.3, zone: "paw",
            marks: [(at: (0, -0.38, 0.07), radii: (0.2, 0.13, 0.2), color: "light", soft: 0.3)]),
        (name: "leg_br", bone: "leg_br", shape: Capsule(to: (0, -0.38, 0.05), r: 0.15), at: (-0.3, -0.57, -0.6),
            blend: 0.12, color: "fur", chonk: 0.3, zone: "paw",
            marks: [(at: (0, -0.38, 0.07), radii: (0.2, 0.13, 0.2), color: "light", soft: 0.3)]),
        // The curl lies on the back, its ring seen side on.
        (name: "tail", bone: "tail", shape: Torus(major: 0.2, minor: 0.12), at: (0.06, 0.22, -0.86),
            rot: (0, 12, 90), blend: 0.08, color: "fur", zone: "bottom",
            marks: [(at: (0, 0, 0), radii: (0.18, 0.3, 0.18), color: "light", soft: 0.3)]),
        (name: "nose", bone: "head", shape: Ellipsoid((0.094, 0.064, 0.068)), at: (0, 0.3, 1.72),
