// Poses every species shares; a model's own `poses` replace these by name.
//
// `root` moves the whole pet about the origin: roll (z), then pitch (x), then
// turn (y), in degrees, then `shift`. Each bone scales and turns about its
// pivot (the model's `pivots`), then shifts. Bones a species lacks are skipped.
// The camera is fixed, so a pose's root turn is also its viewing angle.
//
// Proportions differ by species, so heights are never written here: a bone
// with `rest: true` is lowered until it touches the floor, and afterwards the
// whole pet is settled onto the floor (unless the pose says `rest: false`).
{
    // The default: sitting, turned a little so the 3D shape reads.
    "sit": (
        root: (rot: (0, 20, 0)),
    ),
    // Giggling: rolled onto its side and back, paws in the air.
    "belly_up": (
        root: (rot: (-20, 0, 80), shift: (0.35, 0, 0)),
        bones: {
            "front_legs": (rot: (-90, 0, 0), shift: (0, 0.3, 0)),
            "back_legs": (rot: (-20, 0, 0)),
        },
    ),
    // 厭世: flattened into a puddle, chin on the floor, paws poking out.
    "melt": (
        bones: {
            "body": (scale: (1.3, 0.62, 1.3)),
            "head": (shift: (0, -0.5, 0.18)),
            "front_legs": (rot: (-90, 0, 0), shift: (0, 0, 0.05), rest: true),
            "back_legs": (scale: (1.0, 0.8, 1.0)),
        },
    ),
    // Asleep: a loaf, paws tucked, head sunk in.
    "loaf": (
        root: (rot: (0, 28, 0)),
        bones: {
            "body": (scale: (1.05, 0.82, 1.05)),
            "head": (shift: (0, -0.3, 0.14)),
            "front_legs": (rot: (-90, 0, 0), rest: true),
        },
    ),
    // Sulking: turned away, head hung.
    "sulk": (
        root: (rot: (0, 155, 0)),
        bones: {
            "head": (rot: (12, 0, 0), shift: (0, -0.06, 0)),
        },
    ),
    // Walking, turned the way it goes (the frame mirrors it for going
    // left), face still towards you. Two steps: one diagonal pair of legs
    // forward, then the other; birds step one foot, then the other.
    "walk_a": (
        root: (rot: (0, 52, 0)),
        bones: {
            "head": (rot: (0, -22, 0)),
            "front_legs": (rot: (-32, 0, 0)),
            "front_legs.mirror": (rot: (26, 0, 0)),
            "back_legs": (rot: (24, 0, 0)),
            "back_legs.mirror": (rot: (-28, 0, 0)),
            "wings": (rot: (0, 0, 12)),
        },
    ),
    "walk_b": (
        root: (rot: (0, 52, 0)),
        bones: {
            "head": (rot: (0, -22, 0)),
            "front_legs": (rot: (26, 0, 0)),
            "front_legs.mirror": (rot: (-32, 0, 0)),
            "back_legs": (rot: (-28, 0, 0)),
            "back_legs.mirror": (rot: (24, 0, 0)),
            "wings": (rot: (0, 0, 12)),
        },
    ),
    // Idle glances: the head turns and tilts, the body stays put.
    "look_left": (
        root: (rot: (0, 20, 0)),
        bones: {
            "head": (rot: (0, 38, -9)),
        },
    ),
    "look_right": (
        root: (rot: (0, 20, 0)),
        bones: {
            "head": (rot: (0, -48, 10)),
        },
    ),
    // 伸懶腰: sitting up tall, both front paws (or wings) up high.
    "stretch": (
        root: (rot: (0, 20, 0)),
        bones: {
            "body": (scale: (0.94, 1.1, 0.94)),
            "head": (rot: (-12, 0, 0), shift: (0, 0.1, -0.04)),
            "front_legs": (rot: (-160, 0, 22), shift: (0.1, 0.42, 0.06)),
            "wings": (rot: (0, 0, 125)),
        },
    ),
    // Sitting tall, head tipped back.
    "yawn": (
        root: (rot: (0, 20, 0)),
        bones: {
            "body": (scale: (0.96, 1.06, 0.96)),
            "head": (rot: (-22, 0, 0), shift: (0, 0.06, -0.05)),
        },
    ),
    // One paw (or wing) up beside the face, on the side nearer you.
    "wave": (
        root: (rot: (0, 20, 0)),
        bones: {
            "front_legs": (),
            "front_legs.mirror": (rot: (-155, 0, 25), shift: (0.1, 0.34, 0.14)),
            "wings": (),
            "wings.mirror": (rot: (0, 0, 115)),
        },
    ),
}
