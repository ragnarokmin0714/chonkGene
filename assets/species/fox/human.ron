// 九尾狐's human form (人型形態), after Roger's picture of her parts
// (…3D示意與局部拆解圖2.jpeg) and the 三視圖: a chibi child as tall as the
// beast form with her tails up, a big round head about half her height,
// fox ears on top, big eyes with the beast's marks painted on (face.rs
// `fox_marks`), a short white 古風小長衫 with a crossed collar, wide sleeves
// and an embroidered border at the hem and cuffs, a sash tied in a big bow
// at the front with a bell under it, short legs and bare feet; the nine
// tails behind her from the small of her back, the beast form's lotus a
// little smaller.
//
// Her coat (the beast form's, by the same names) gives the tails, the
// marks, the eyes, the trim, the sash and the bell; the hair's colour is
// chosen on its own (`hairs`, white by default), and so is the hairdo
// (parts with a `style`: 綁單馬尾, 綁雙馬尾, 公主頭).
// The tails come from gen_tails.py: `python3 gen_tails.py human | python3
// ../splice.py human.ron`.
(
    species: "fox",
    bake_cell: 0.03,
    canvas: Some((4.8, 3.3)),
    // Sixteen at most: the shaders hold sixteen.
    slots: ["skin", "robe", "trim", "gold", "sash", "hair", "hairtip", "ribbon", "fur", "tailmid", "tailtip", "ink", "blush", "mark", "iris", "brow"],
    swatch: Some(("fur", "mark")),
    coats: [
        // 紅髮版's colours: a red and gold border, a red sash braided with
        // gold, a gold bell (`gold` is the braid and the bell); red marks,
        // pink-red eyes.
        (name: "white", colors: {
            "skin": "#FFE9DF", "robe": "#FFFDF9", "trim": "#D8323F", "gold": "#F2C14E", "sash": "#D8323F",
            "hair": "#F6F7FB", "hairtip": "#E3E8F2", "ribbon": "#D8323F",
            "fur": "#FFF9F3", "tailmid": "#F7A8B8", "tailtip": "#D93050",
            "ink": "#3B2A22", "blush": "#FF9AAE", "mark": "#E3354B", "iris": "#E0607E", "brow": "#DCC2A8",
        }),
        // 銀白版's: a silver border, a white rope with a silver bell, ice-blue
        // marks and eyes.
        (name: "snow", colors: {
            "skin": "#FFE9DF", "robe": "#FFFDFB", "trim": "#A9B6CB", "gold": "#B9C3D2", "sash": "#F1F3F7",
            "hair": "#F6F7FB", "hairtip": "#E3E8F2", "ribbon": "#D8323F",
            "fur": "#FBFCFF", "tailmid": "#DCEEFB", "tailtip": "#8CCBF2",
            "ink": "#2B2F3E", "blush": "#FFB3C4", "mark": "#5DB8EC", "iris": "#4A8FDB", "brow": "#D5D2D4",
        }),
        (name: "gold", colors: {
            "skin": "#FFE9DF", "robe": "#FFFDF9", "trim": "#D8323F", "gold": "#F2C14E", "sash": "#D8323F",
            "hair": "#F6F7FB", "hairtip": "#E3E8F2", "ribbon": "#D8323F",
            "fur": "#F0A050", "tailmid": "#FBD9B0", "tailtip": "#FFFFFF",
            "ink": "#3B2A22", "blush": "#FF8C94", "mark": "#E8454F", "iris": "#B8742A", "brow": "#FFF1DC",
        }),
        (name: "night", colors: {
            "skin": "#FFE9DF", "robe": "#FBFAFF", "trim": "#6F7CC0", "gold": "#C8D0E0", "sash": "#4A4060",
            "hair": "#F6F7FB", "hairtip": "#E3E8F2", "ribbon": "#D8323F",
            "fur": "#4A4060", "tailmid": "#7A88C8", "tailtip": "#9FE3FF",
            "ink": "#231C2A", "blush": "#FF8CA8", "mark": "#7FD4FF", "iris": "#58B8F0", "brow": "#9A8CB8",
