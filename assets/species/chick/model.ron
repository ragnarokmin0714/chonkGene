// Chick: a fluffy ball on a slightly smaller ball, a tuft, stubby wings, a
// tiny beak and orange toes. Smaller than the others. Units are roughly
// head radii; the floor is at y = -1.1, +z faces the camera.
(
    species: "chick",
    slots: ["feather", "belly", "wing", "tuft", "eye", "beak", "blush"],
    coats: [
        (name: "yellow", colors: {
            "feather": "#FFD95E", "belly": "#FFF0B8", "wing": "#F5C842", "tuft": "#F5C842",
            "eye": "#3B2A22", "beak": "#F29B38", "blush": "#FF9A9A",
        }),
        (name: "white", colors: {
            "feather": "#FAF7F0", "belly": "#FFFFFF", "wing": "#E9E3D6", "tuft": "#E9E3D6",
            "eye": "#3B2A22", "beak": "#F29B38", "blush": "#FF9A9A",
        }),
        (name: "brown", colors: {
            "feather": "#C8946A", "belly": "#F1DCC6", "wing": "#B07D55", "tuft": "#B07D55",
            "eye": "#3B2A22", "beak": "#F29B38", "blush": "#FF9A9A",
        }),
        (name: "silkie", colors: {
            "feather": "#4A4A52", "belly": "#6A6A73", "wing": "#3A3A40", "tuft": "#5A5A64",
            "eye": "#F0E6C8", "beak": "#7A8A9A", "blush": "#FF9A9A",
        }),
    ],
    pivots: {
        "body": (0, -1.1, 0),
        "head": (0, 0.05, 0.05),
        "back_legs": (0, -1.0, 0.3),
        "wings": (0.68, -0.08, -0.02),
        "tail": (0, -0.62, -0.64),
    },
    parts: [
        (name: "body", bone: "body", shape: Ellipsoid((0.86, 0.66, 0.8)), at: (0, -0.46, 0),
            color: "feather", chonk: 1.0, zone: "bottom",
            marks: [(at: (0, -0.05, 0.6), radii: (0.5, 0.6, 0.45), color: "belly", soft: 0.35, zone: Some("belly"))]),
        (name: "head", bone: "head", shape: Ellipsoid((0.8, 0.72, 0.76)), at: (0, 0.36, 0.08),
            blend: 0.32, color: "feather", zone: "head",
            marks: [(at: (0.45, -0.2, 0.45), radii: (0.25, 0.22, 0.3), color: "feather", soft: 0.4, zone: Some("cheek"), mirror: true)]),
        // Three wisps on top.
        (name: "tuft", bone: "head", shape: Capsule(to: (0.0, 0.24, -0.04), r: 0.05), at: (0, 1.03, 0.05),
            blend: 0.08, color: "tuft", zone: "head"),
        (name: "tuft_side", bone: "head", shape: Capsule(to: (0.12, 0.18, -0.02), r: 0.045), at: (0.08, 1.01, 0.04),
            blend: 0.08, color: "tuft", mirror: true, zone: "head"),
        (name: "wing", bone: "wings", shape: Ellipsoid((0.16, 0.34, 0.3)), at: (0.78, -0.35, -0.02),
            rot: (0, 0, 24), blend: 0.08, color: "wing", chonk: 0.8, mirror: true, zone: "bottom"),
        (name: "tail", bone: "tail", shape: Cone(r1: 0.14, r2: 0.04, h: 0.22, flat: 2.0), at: (0, -0.62, -0.7),
            rot: (-60, 0, 0), blend: 0.08, color: "wing", zone: "bottom"),
        (name: "toe", bone: "back_legs", shape: Ellipsoid((0.06, 0.05, 0.13)), at: (0.22, -1.05, 0.5),
