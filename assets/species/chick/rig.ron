// Chick rig. Part ids are element ids in standard.svg / mochi.svg, listed
// back to front. Compile with `cargo xtask art`.
(
    species: "chick",
    size: (200, 184),
    ground_y: 176,
    slots: ["shadow", "feather", "belly", "wing", "comb", "eye", "white", "beak", "beak_light", "blush"],
    coats: [
        (name: "yellow", colors: {
            "shadow": "#3B2A2217", "feather": "#FFD95E", "belly": "#FFF0B8", "wing": "#F5C842", "comb": "#F2685B",
