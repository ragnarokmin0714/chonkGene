// The settings window (PLAN §1.6–§1.11, mockup in §1.9).
// Labels are plain; the cuteness lives in hints and the pet's own lines.

import { AboutSlint, ScrollView } from "std-widgets.slint";
import "../../../assets/fonts/jf-openhuninn-2.1.ttf";

export struct PetRow {
    id: string,
    name: string,
    dot: color,
    ring: color,
    // 常駐: never swapped back to 寵物窩 (換班, 隨機輪班).
    pinned: bool,
    // The name as it looks, drawn under the cursor while it is dragged,
    // and the point in it the cursor holds (the dot's middle), in its
    // pixels.
    chip: image,
    hot: int,
}

export struct CoatRow {
    id: string,
    label: string,
    main: color,
    light: color,
}

export struct SpeciesRow {
    id: string,
    label: string,
    blurb: string,
    portrait: image,
    tint: color,
}

global Theme {
    out property <color> bg: #FFF8EF;
    out property <color> side: #FFF0E0;
    out property <color> card: #FFFFFF;
    out property <color> ink: #4B3528;
    out property <color> muted: #7A6253;
    out property <color> line: #F0DFCC;
    out property <color> accent: #D9772F;
    out property <color> peach: #FFB37A;
    out property <color> peach-deep: #E08A4E;
    out property <color> track: #EADBCB;
    out property <color> hover: #FFEEDB;
    out property <color> danger: #B23B3B;
}

component Label inherits Text {
    color: Theme.ink;
    font-size: 15px;
    vertical-alignment: center;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

/// A one-line text box in the window's own look (Roger, 2026-11-19: the
/// standard box did not match it, finishing an entry was unclear, and it
/// took more than fits): a rounded white field, a peach ring while typing,
/// how many characters of `max` on its right; no more than `max` go in.
/// Typing ends with Enter or a click elsewhere (or the page or the window
/// closing, see the settings code): `committed` stores it and gives back
/// what was stored (an empty entry is put back), and 「已儲存」 shows a
/// moment.
component CuteField inherits Rectangle {
    in-out property <string> text;
    in property <int> max: 12;
    pure callback keep-first(string, int) -> string;
    callback committed(string) -> string;
    // Set to have the box take the focus with its text selected, as soon
    // as it is shown (or at once if it is); it clears itself.
    in-out property <bool> focus-ask;
    property <bool> typing: input.has-focus;
    property <bool> saved;
    height: 44px;
    min-width: 120px;
    preferred-width: 160px;
    horizontal-stretch: 1;
    border-radius: 22px;
    background: Theme.card;
    border-width: 2px;
    border-color: typing ? Theme.peach : area.has-hover ? Theme.peach.with-alpha(0.55) : Theme.line;
    animate border-color { duration: 150ms; }
    changed typing => {
        if !self.typing {
            self.text = self.committed(self.text);
            self.saved = true;
        } else {
            self.saved = false;
        }
    }
    function take-focus() {
        if root.focus-ask {
            root.focus-ask = false;
            input.focus();
            input.select-all();
        }
    }
    init => { root.take-focus(); }
    changed focus-ask => { root.take-focus(); }
    area := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    // The text slides along under a clip so the cursor stays in sight
    // (as the standard box does): twelve characters do not fit beside the
    // count.
    Rectangle {
        x: 16px;
        width: root.width - 32px - count.preferred-width - 8px;
        height: root.height;
        clip: true;
        input := TextInput {
            property <length> slide;
            x: Math.min(0px, Math.max(parent.width - self.width - self.text-cursor-width, self.slide));
            width: Math.max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            font-size: 15px;
            color: Theme.ink;
            selection-background-color: Theme.peach.with-alpha(0.45);
            selection-foreground-color: Theme.ink;
            text <=> root.text;
            cursor-position-changed(at) => {
                if at.x + self.slide < 0px {
                    self.slide = -at.x;
                } else if at.x + self.slide > parent.width - self.text-cursor-width {
                    self.slide = parent.width - at.x - self.text-cursor-width;
                }
            }
            edited => {
                if self.text.character-count > root.max {
                    self.text = root.keep-first(self.text, root.max);
                }
            }
            accepted => { self.clear-focus(); }
            // Esc: what was typed is dropped, the stored one comes back (an
            // empty entry is put back when stored).
            key-pressed(event) => {
                if event.text == Key.Escape {
                    self.text = "";
                    self.clear-focus();
                    return accept;
                }
                return reject;
            }
        }
    }
    count := Text {
        x: root.width - 16px - self.preferred-width;
        height: root.height;
        vertical-alignment: center;
        font-size: 12px;
        text: root.saved ? @tr("已儲存") : root.typing ? "\{root.text.character-count}/\{root.max}" : "";
        color: root.saved ? Theme.accent : root.text.character-count >= root.max ? Theme.accent : Theme.muted;
    }
    Timer {
        interval: 1.6s;
        running: root.saved;
        triggered => { root.saved = false; }
    }
}

component PawSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 60px;
    height: 34px;
    border-radius: 17px;
    background: checked ? Theme.peach : Theme.track;
    animate background { duration: 250ms; }
    Rectangle {
        x: root.checked ? 29px : 3px;
        y: 3px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #4B352840;
        animate x { duration: 450ms; easing: cubic-bezier(0.3, 1.6, 0.5, 1.0); }
        property <color> pad: root.checked ? #F08C9A : #CDBBA9;
        Rectangle { x: 9px; y: 13px; width: 10px; height: 8px; border-radius: 4px; background: pad; }
        Rectangle { x: 5px; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 9px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 15px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 19px; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component CuteButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    min-width: label.preferred-width + 36px;
    border-radius: 20px;
    background: !enabled ? Theme.track : primary ? (ta.pressed ? #F5A86E : Theme.peach) : (ta.pressed || ta.has-hover ? Theme.hover : Theme.card);
    border-width: primary ? 0px : 1.5px;
    border-color: danger ? #F2C4C4 : Theme.line;
    drop-shadow-blur: 0px;
    drop-shadow-offset-y: primary && enabled ? (ta.pressed ? 1px : 4px) : 0px;
    drop-shadow-color: Theme.peach-deep;
    animate drop-shadow-offset-y { duration: 120ms; }
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.muted : root.danger ? Theme.danger : Theme.ink;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A slider with a bone for a thumb that gets chunkier with `chonk`.
component BoneSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> chonk: 0.33;
    callback changed(float);
    height: 34px;
    min-width: 160px;
    horizontal-stretch: 1;
    property <float> t: (value - minimum) / (maximum - minimum);
    Rectangle {
        y: (parent.height - 12px) / 2;
        height: 12px;
        border-radius: 6px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 12px) / 2;
        width: root.t * (root.width - thumb.w) + thumb.w / 2;
        height: 12px;
        border-radius: 6px;
        background: Theme.peach;
    }
    thumb := Rectangle {
        property <length> w: 34px + 16px * root.chonk;
        width: w;
        height: 26px;
        x: root.t * (root.width - w);
        y: (root.height - 26px) / 2;
        // Bone: two knobs on each end joined by a bar, with an outline.
        Rectangle { x: 6px; y: 7px; width: parent.width - 12px; height: 12px; border-radius: 3px; background: white; border-width: 2px; border-color: Theme.peach-deep; }
        for k in [{x: 0, y: 0}, {x: 0, y: 1}, {x: 1, y: 0}, {x: 1, y: 1}]: Rectangle {
            x: k.x * (parent.width - 13px);
            y: k.y * 13px;
            width: 13px;
            height: 13px;
            border-radius: 6.5px;
            background: white;
            border-width: 2px;
            border-color: Theme.peach-deep;
        }
        Rectangle { x: 7px; y: 9px; width: parent.width - 14px; height: 8px; background: white; }
    }
    TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            root.value = root.minimum + max(0, min(1, (x - thumb.w / 2) / (root.width - thumb.w))) * (root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

/// A plain round-thumb slider for personality.
component MiniSlider inherits Rectangle {
    in-out property <float> value;
    callback changed(float);
    height: 26px;
    min-width: 100px;
    horizontal-stretch: 1;
    Rectangle { y: 9px; height: 8px; border-radius: 4px; background: Theme.track; }
    Rectangle { x: 0; y: 9px; width: root.value * (root.width - 22px) + 11px; height: 8px; border-radius: 4px; background: Theme.peach; }
    Rectangle {
        x: root.value * (root.width - 22px);
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        border-width: 4px;
        border-color: Theme.peach;
    }
    TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            root.value = max(0, min(1, (x - 11px) / (root.width - 22px)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback picked(int);
    height: 44px;
    border-radius: 22px;
    background: Theme.track;
    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for label[i] in root.options: Rectangle {
            border-radius: 18px;
            background: i == root.selected ? Theme.card : transparent;
            min-width: t.preferred-width + 28px;
            t := Text {
                text: label;
                color: i == root.selected ? Theme.ink : Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 46px;
    border-radius: 16px;
    background: active ? Theme.card : ta.has-hover ? Theme.hover : transparent;
    drop-shadow-offset-y: active ? 3px : 0px;
    drop-shadow-color: Theme.line;
    HorizontalLayout {
        padding-left: 16px;
        Text {
            text: root.text;
            color: root.active ? Theme.ink : Theme.muted;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Section inherits Rectangle {
    background: Theme.card;
    border-radius: 22px;
    border-width: 1.5px;
    border-color: Theme.line;
}

component Row inherits HorizontalLayout {
    padding-top: 14px;
    padding-bottom: 14px;
    spacing: 16px;
    alignment: space-between;
}

/// One pet's name, with its coat's dot, in 「出場中」 or 「在寵物窩休息」
/// (Roger, 2026-11-19): click to pick it, drag it to another place,
/// double-click to make it 常駐 (or not).
component PetChip inherits Rectangle {
    in property <PetRow> pet;
    in property <bool> picked;
    in property <data-transfer> data;
    callback select();
    callback double-clicked();
    // A name dropped on this one: before it, or after it (on its right
    // half).
    callback dropped-on(data-transfer, bool);
    property <bool> after;
    tag-size := Text { visible: false; text: @tr("常駐"); font-size: 12px; }
    height: 44px;
    width: name.preferred-width + 58px + (pet.pinned ? tag-size.preferred-width + 20px : 0px);
    border-radius: 22px;
    background: Theme.card;
    border-width: 2px;
    border-color: picked ? Theme.accent : Theme.line;
    opacity: drag.dragging ? 0.35 : 1.0;
    Rectangle {
        x: 8px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: pet.dot;
        Rectangle { y: 20px; height: 8px; border-radius: 4px; background: pet.ring; }
    }
    name := Text {
        x: 44px;
        text: pet.name;
        color: Theme.ink;
        font-size: 15px;
        vertical-alignment: center;
    }
    if pet.pinned: Rectangle {
        x: name.x + name.preferred-width + 8px;
        y: 11px;
        width: tag-size.preferred-width + 12px;
        height: 22px;
        border-radius: 11px;
        background: Theme.peach;
        Text {
            text: tag-size.text;
            color: white;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    drag := DragArea {
        data: root.data;
        allow-move: true;
        drag-image: root.pet.chip;
        drag-image-offset-x: root.pet.hot;
        drag-image-offset-y: root.pet.hot;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.select(); }
            double-clicked => { root.double-clicked(); }
        }
    }
    // Where it would go: a bar on the side it would be dropped.
    if drop.has-drag: Rectangle {
        x: root.after ? root.width + 2px : -6px;
        y: 4px;
        width: 4px;
        height: root.height - 8px;
        border-radius: 2px;
        background: Theme.accent;
    }
    drop := DropArea {
        can-drop(e) => {
            root.after = e.position.x > root.width / 2;
            return DragAction.move;
        }
        dropped(e) => {
            root.dropped-on(e.data, e.position.x > root.width / 2);
            return DragAction.move;
        }
    }
}

/// 「出場中」 or 「在寵物窩休息」: its pets' names; a name dropped on the
/// card, not on another name, goes last.
component PetCard inherits Section {
    in property <string> title;
    in property <string> count;
    in property <string> hint;
    in property <[PetRow]> pets;
    in property <string> selected-pet;
    pure callback drag-data(string) -> data-transfer;
    callback select-pet(string);
    callback double-clicked(string);
    // A name dropped here: on the name with this id ("" on the card), and
    // after it.
    callback dropped(data-transfer, string, bool);
    background: card-drop.has-drag ? Theme.hover : Theme.card;
    border-color: card-drop.has-drag ? Theme.peach : Theme.line;
    card-drop := DropArea {
        can-drop(e) => { return DragAction.move; }
        dropped(e) => {
            root.dropped(e.data, "", false);
            return DragAction.move;
        }
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.title; color: Theme.ink; font-size: 16px; font-weight: 600; vertical-alignment: center; }
            Text { text: root.count; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        }
        FlexboxLayout {
            spacing: 10px;
            for p in root.pets: PetChip {
                pet: p;
                picked: p.id == root.selected-pet;
                data: root.drag-data(p.id);
                select => { root.select-pet(p.id); }
                double-clicked => { root.double-clicked(p.id); }
                dropped-on(d, after) => { root.dropped(d, p.id, after); }
            }
        }
        Hint { text: root.hint; }
    }
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 13px;
    font-weight: 600;
}

export component SettingsWindow inherits Window {
    title: @tr("肉肉賴桌・設定");
    // Set from Rust on Linux; Windows takes the exe's own icon instead.
    in property <image> window-icon;
    icon: window-icon;
    preferred-width: 880px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "jf-openhuninn-2.1";

    // Bumped to repaint the whole window: on Windows the software renderer
    // redraws only what changed, and a lost first frame would otherwise stay
    // black until something moves.
    in property <int> repaint;

    // Navigation.
    in-out property <int> tab: 0;

    // Pets: 「出場中」 (out on the desktop, in order) and 「在寵物窩休息」
    // (the first is the next to come out).
    in property <[PetRow]> desk-pets;
    in property <[PetRow]> den-pets;
    in-out property <string> selected-pet;
    in property <bool> adopting;
    in property <[SpeciesRow]> species;
    in property <[CoatRow]> adopt-coats;
    in-out property <string> adopt-species;
    in-out property <string> adopt-coat;
    callback select-pet(string);
    callback start-adopting();
    callback pick-adopt-species(string);
    callback pick-adopt-coat(string);
    callback adopt();

    in property <string> species-label;
    in-out property <string> pet-name;
    // Focus the name box, its text selected (opened from a pet's 設定…).
    in-out property <bool> name-focus;
    in-out property <string> pet-you;
    in property <[CoatRow]> coats;
    in-out property <string> coat;
    in-out property <float> chonk;
    in-out property <float> size;
    in-out property <float> ticklish;
    in-out property <float> patience;
    in-out property <float> energy;
    in property <image> preview;
    in property <color> preview-tint;
    in property <string> preview-line;
    in property <string> level-text;
    in-out property <bool> confirm-release;
    // The name and 「牠怎麼叫你」 as typed: stored, and what was stored
    // given back (see CuteField); `keep-first` keeps the first so many
    // characters; `commit-fields` stores both as they stand (the page
    // changed).
    callback name-committed(string) -> string;
    callback you-committed(string) -> string;
    pure callback keep-first(string, int) -> string;
    callback commit-fields();
    in property <int> name-max: 12;
    in property <int> you-max: 8;
    callback coat-picked(string);
    callback chonk-changed(float);
    callback size-changed(float);
    callback trait-changed(int, float);
    // Dragging names: what one carries (its id); a name dropped in
    // 「出場中」 (true) or 「在寵物窩休息」, on the name with this id ("": on
    // the card), after it; a double-click on a name out (常駐).
    pure callback drag-data(string) -> data-transfer;
    callback pet-dropped(data-transfer, bool, string, bool);
    callback pin-pet(string);
    callback release();

    // Interaction & sound.
    in-out property <bool> sound;
    in-out property <float> volume;
    in-out property <bool> irrational;
    in-out property <int> squabble;
    // 0 跟著電腦, then 繁體中文, 日本語, English (i18n::Lang::ALL).
    in-out property <int> language;
    callback sound-toggled(bool);
    callback volume-changed(float);
    callback irrational-toggled(bool);
    callback squabble-picked(int);
    callback language-picked(int);

    // Don't disturb.
    in-out property <bool> hide-fullscreen;
    callback hide-fullscreen-toggled(bool);
    in-out property <bool> react-input;
    callback react-input-toggled(bool);

    // General.
    in-out property <bool> start-login;
    in-out property <int> desktop-limit;
    // 隨機輪班: an index into store::ROTATE_CHOICES (0 off).
    in-out property <int> rotate;
    callback rotate-picked(int);
    in property <string> data-path;
    in property <string> notice;
    in property <string> version;
    callback start-login-toggled(bool);
    callback desktop-limit-changed(int);
    // 大家的大小: every pet's size at once, percent; the one they all have
    // now (0 when they differ).
    in property <int> size-all;
    callback size-all-picked(int);
    callback open-folder();
    callback remove-traces();

    // Under everything, its colour a hair off every other repaint: changing
    // it marks the whole window dirty.
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg.with-alpha(Math.mod(root.repaint, 2) == 0 ? 1.0 : 0.99);
    }
    // A click on the window's background ends typing in a box (the focus
    // goes here, so the box stores what was typed).
    TouchArea {
        clicked => { focus-sink.focus(); }
    }
    focus-sink := FocusScope {
        width: 0px;
        height: 0px;
    }
    changed tab => { root.commit-fields(); }

    HorizontalLayout {
        // Sidebar.
        Rectangle {
            width: 200px;
            background: Theme.side;
            VerticalLayout {
                padding: 14px;
                padding-top: 22px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-bottom: 12px;
                    Text { text: @tr("肉肉賴桌"); color: Theme.accent; font-size: 18px; font-weight: 700; }
                }
                NavItem { text: @tr("我的寵物"); active: root.tab == 0; clicked => { root.tab = 0; } }
                NavItem { text: @tr("互動與聲音"); active: root.tab == 1; clicked => { root.tab = 1; } }
                NavItem { text: @tr("不打擾"); active: root.tab == 2; clicked => { root.tab = 2; } }
                NavItem { text: @tr("一般"); active: root.tab == 3; clicked => { root.tab = 3; } }
            }
        }

        ScrollView {
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                if root.notice != "": Rectangle {
                    background: #FDE2E2;
                    border-radius: 14px;
                    height: notice-text.preferred-height + 20px;
                    notice-text := Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: root.notice;
                        color: Theme.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // ── 我的寵物 ──
                if root.tab == 0: VerticalLayout {
                    spacing: 16px;
                    alignment: start;
                    // Roger's twenty-second pass: the adopt button sat at the
                    // end of a sideways-scrolling row of names, out of sight
                    // with the seven pets a new desk starts with. Now it has
                    // its own place on top, and the names wrap onto rows.
                    // 說再見… sits here too (Roger, 2026-11-19: easier to
                    // reach than under the pet), asking first in this row.
                    if !root.confirm-release || root.adopting: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.adopting ? @tr("領養新寵物") : @tr("我的寵物");
                            color: Theme.ink;
                            font-size: 20px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if !root.adopting && root.selected-pet != "": CuteButton {
                            text: @tr("說再見…");
                            primary: false;
                            danger: true;
                            clicked => { root.confirm-release = true; }
                        }
                        if root.adopting && root.desk-pets.length + root.den-pets.length > 0: CuteButton {
                            text: @tr("算了");
                            primary: false;
                            clicked => { root.select-pet(root.selected-pet); }
                        }
                        if root.adopting: CuteButton {
                            text: root.adopt-species == "" ? @tr("先點一隻吧") : @tr("帶牠回家");
                            enabled: root.adopt-species != "";
                            clicked => { root.adopt(); }
                        }
                        if !root.adopting: CuteButton {
                            text: @tr("＋ 領養新寵物");
                            clicked => { root.start-adopting(); }
                        }
                    }
                    if root.confirm-release && !root.adopting: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Label { text: @tr("確定要和{}說再見嗎？", root.pet-name); }
                            Hint { text: @tr("牠的名字和親密度會一起消失。"); }
                        }
                        CuteButton { text: @tr("再想想"); primary: false; clicked => { root.confirm-release = false; } }
                        CuteButton { text: @tr("說再見"); primary: false; danger: true; clicked => { root.release(); } }
                    }

                    // Who is out (Roger, 2026-11-19): 「出場中」 on top,
                    // 「在寵物窩休息」 under it. Drag a name from one to the
                    // other, or along one to change its place; double-click
                    // one out to make it 常駐.
                    if !root.adopting: PetCard {
                        title: @tr("出場中");
                        count: @tr("{} / {} 隻", root.desk-pets.length, root.desktop-limit);
                        hint: @tr("拖進來就會出場；點兩下設為常駐，就不會被換下來。");
                        pets: root.desk-pets;
                        selected-pet: root.selected-pet;
                        drag-data(id) => { return root.drag-data(id); }
                        select-pet(id) => { root.select-pet(id); }
                        double-clicked(id) => { root.pin-pet(id); }
                        dropped(d, on, after) => { root.pet-dropped(d, true, on, after); }
                    }
                    if !root.adopting: PetCard {
                        title: @tr("在寵物窩休息");
                        count: root.den-pets.length > 0 ? @tr("{} 隻", root.den-pets.length) : "";
                        hint: root.den-pets.length > 0 ? @tr("拖到上面就會出場。") : @tr("把寵物拖到這裡，牠就會回寵物窩休息。");
                        pets: root.den-pets;
                        selected-pet: root.selected-pet;
                        drag-data(id) => { return root.drag-data(id); }
                        select-pet(id) => { root.select-pet(id); }
                        double-clicked(id) => { root.select-pet(id); }
                        dropped(d, on, after) => { root.pet-dropped(d, false, on, after); }
                    }

                    // Adoption: four small cards a row, so all seven show at
                    // once with the button above; the coats are picked on the
                    // card itself, which then shows the pet in that coat.
                    if root.adopting: VerticalLayout {
                        spacing: 12px;
                        Hint { text: @tr("挑一隻帶回你的桌面吧，點牠還能選毛色。"); }
                        GridLayout {
                            spacing: 10px;
                            for s[i] in root.species: Rectangle {
                                col: mod(i, 4);
                                row: floor(i / 4);
                                height: 194px;
                                // Four equal columns, however long a name or
                                // blurb is (Japanese ones run long) and
                                // whichever card shows its coats: a quarter
                                // of the page (the window less the 200 px
                                // sidebar, the page's padding and the gaps),
                                // not of what is in them.
                                width: (root.width - 200px - 48px - 30px) / 4;
                                border-radius: 20px;
                                background: Theme.card;
                                border-width: 2.5px;
                                border-color: s.id == root.adopt-species ? Theme.accent : Theme.line;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick-adopt-species(s.id); }
                                }
                                VerticalLayout {
                                    padding: 7px;
                                    spacing: 4px;
                                    alignment: start;
                                    Rectangle {
                                        height: 104px;
                                        border-radius: 14px;
                                        background: s.tint;
                                        Image { source: s.portrait; height: 98px; image-fit: contain; }
                                    }
                                    Text { text: s.label; color: Theme.ink; font-size: 15px; horizontal-alignment: center; overflow: elide; min-width: 0; }
                                    if s.id != root.adopt-species: Text {
                                        text: s.blurb;
                                        color: Theme.muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    if s.id == root.adopt-species: HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        alignment: center;
                                        for c in root.adopt-coats: Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            y: 2px;
                                            border-radius: 14px;
                                            border-width: c.id == root.adopt-coat ? 2.5px : 0px;
                                            border-color: Theme.accent;
                                            Rectangle {
                                                x: 4px; y: 4px; width: 20px; height: 20px; border-radius: 10px; background: c.main; border-width: 1px; border-color: #00000018;
                                                Rectangle { y: 14px; height: 6px; border-radius: 3px; background: c.light; }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.pick-adopt-coat(c.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Editing the selected pet.
                    if !root.adopting && root.selected-pet != "": HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        // The pet (whether it is out and 說再見 moved to the
                        // cards and the title row, Roger 2026-11-19).
                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            width: 240px;
                            Rectangle {
                                width: 240px;
                                height: 420px;
                                border-radius: 26px;
                                background: root.preview-tint;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    alignment: end;
                                    Rectangle {
                                        height: bubble-text.preferred-height + 18px;
                                        border-radius: 18px;
                                        background: white;
                                        bubble-text := Text {
                                            text: root.preview-line;
                                            color: Theme.ink;
                                            font-size: 17px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Image { source: root.preview; height: 220px; image-fit: contain; }
                                    Text { text: root.pet-name; color: Theme.ink; font-size: 22px; horizontal-alignment: center; }
                                    Text { text: root.species-label + @tr("・") + root.level-text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 12px;
                                // Two boxes of one width, sharing the row.
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { text: @tr("名字"); }
                                    CuteField {
                                        text <=> root.pet-name;
                                        focus-ask <=> root.name-focus;
                                        max: root.name-max;
                                        keep-first(t, n) => { return root.keep-first(t, n); }
                                        committed(t) => { return root.name-committed(t); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    Label { text: @tr("牠怎麼叫你"); }
                                    CuteField {
                                        text <=> root.pet-you;
                                        max: root.you-max;
                                        keep-first(t, n) => { return root.keep-first(t, n); }
                                        committed(t) => { return root.you-committed(t); }
                                    }
                                }
                            }
                            Hint { text: @tr("牠在對話泡泡裡會這樣叫你。"); }

                            Label { text: @tr("毛色"); }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                for c in root.coats: VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 22px;
                                        border-width: c.id == root.coat ? 3px : 0px;
                                        border-color: Theme.accent;
                                        Rectangle {
                                            x: 5px; y: 5px; width: 34px; height: 34px; border-radius: 17px; background: c.main; border-width: 1px; border-color: #00000018;
                                            Rectangle { y: 25px; height: 9px; border-radius: 4.5px; background: c.light; }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.coat-picked(c.id); }
                                        }
                                    }
                                    Text { text: c.label; color: c.id == root.coat ? Theme.ink : Theme.muted; font-size: 12px; horizontal-alignment: center; }
                                }
                            }

                            Label { text: @tr("體型"); }
                            BoneSlider {
                                value <=> root.chonk;
                                chonk: root.chonk;
                                changed(v) => { root.chonk-changed(v); }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                for stop[i] in [@tr("標準"), @tr("略肥（預設）"), @tr("圓滾滾"), @tr("麻糬")]: Text {
                                    text: stop;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.chonk = [0.0, 0.33, 0.66, 1.0][i];
                                            root.chonk-changed(root.chonk);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Label { text: @tr("大小"); }
                                Text { text: round(root.size * 100) + "%"; color: Theme.muted; font-size: 14px; }
                            }
                            BoneSlider {
                                value <=> root.size;
                                minimum: 0.5;
                                maximum: 2.0;
                                chonk: 0.2;
                                changed(v) => { root.size-changed(v); }
                            }
                            Hint { text: @tr("牠在桌面上看起來有多大。"); }

                            Label { text: @tr("個性"); }
                            for t[i] in [{label: @tr("怕癢"), lo: @tr("不怕"), hi: @tr("超怕")}, {label: @tr("耐性"), lo: @tr("沒耐性"), hi: @tr("很有耐性")}, {label: @tr("活潑"), lo: @tr("懶洋洋"), hi: @tr("停不下來")}]: HorizontalLayout {
                                spacing: 8px;
                                Text { text: t.label; width: 40px; color: Theme.ink; font-size: 14px; vertical-alignment: center; }
                                Text { text: t.lo; width: 52px; color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                MiniSlider {
                                    value: i == 0 ? root.ticklish : i == 1 ? root.patience : root.energy;
                                    changed(v) => { root.trait-changed(i, v); }
                                }
                                Text { text: t.hi; width: 64px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                            }
                            Hint { text: @tr("會影響被戳的時候，是翻肚爆笑還是一臉厭世。"); }

                        }
                    }
                }

                // ── 互動與聲音 ──
                if root.tab == 1: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: @tr("互動與聲音"); color: Theme.ink; font-size: 24px; }
                    SectionTitle { text: @tr("聲音"); }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("聲音模式"); }
                                    Hint { text: @tr("讓牠們叫、笑、打呼。全螢幕時會自動安靜。"); }
                                }
                                PawSwitch { checked <=> root.sound; toggled(v) => { root.sound-toggled(v); } }
                            }
                            Row {
                                Label { text: @tr("音量"); width: 80px; }
                                BoneSlider {
                                    value <=> root.volume;
                                    chonk: 0.1;
                                    changed(v) => { root.volume-changed(v); }
                                }
                                Text { text: round(root.volume * 100) + "%"; width: 48px; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                    }
                    SectionTitle { text: @tr("非理性模式"); }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("非理性模式"); }
                                    Hint { text: @tr("兩隻以上時，偶爾會為了小事吵起來，最後一定和好。點吵架中的任何一隻可以勸架。"); }
                                }
                                PawSwitch { checked <=> root.irrational; toggled(v) => { root.irrational-toggled(v); } }
                            }
                            Row {
                                Label { text: @tr("吵架頻率"); }
                                Segmented {
                                    options: [@tr("偶爾"), @tr("常常"), @tr("超常")];
                                    selected <=> root.squabble;
                                    picked(i) => { root.squabble-picked(i); }
                                }
                            }
                        }
                    }
                }

                // ── 不打擾 ──
                if root.tab == 2: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: @tr("不打擾"); color: Theme.ink; font-size: 24px; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("全螢幕時躲起來"); }
                                    Hint { text: @tr("看影片、玩遊戲或簡報時，牠們會先躲起來，結束後再回來。"); }
                                }
                                PawSwitch { checked <=> root.hide-fullscreen; toggled(v) => { root.hide-fullscreen-toggled(v); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("陪你打字和看書"); }
                                    Hint { text: @tr("打字時牠們會跟著拍拍腳，滑鼠停著時會趴下來陪你。只看鍵盤和滑鼠有沒有在用，不會讀你打的字。"); }
                                }
                                PawSwitch { checked <=> root.react-input; toggled(v) => { root.react-input-toggled(v); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("一鍵收起來"); }
                                    Hint { text: @tr("再按一次就叫回來。"); }
                                }
                                Text { text: "Ctrl + Alt + P"; color: Theme.ink; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // ── 一般 ──
                if root.tab == 3: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: @tr("一般"); color: Theme.ink; font-size: 24px; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            // Each language's name in itself, so it can be
                            // found whatever the window is in now.
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("語言"); }
                                    Hint { text: @tr("跟著電腦：照電腦的語言顯示。"); }
                                }
                                Segmented {
                                    options: [@tr("跟著電腦"), "繁體中文", "日本語", "English"];
                                    selected <=> root.language;
                                    picked(i) => { root.language-picked(i); }
                                }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("開機時一起醒來"); }
                                    Hint { text: @tr("電腦開機後，牠們會自動出現在桌面上。"); }
                                }
                                PawSwitch { checked <=> root.start-login; toggled(v) => { root.start-login-toggled(v); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("同時在桌面上的寵物"); }
                                    Hint { text: root.desktop-limit > 7 ? @tr("寵物越多，用的電腦資源也越多。") : @tr("其他的會在寵物窩休息。"); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    CuteButton { text: "－"; primary: false; enabled: root.desktop-limit > 1; clicked => { root.desktop-limit-changed(root.desktop-limit - 1); } }
                                    Text { text: @tr("{} 隻", root.desktop-limit); color: Theme.ink; font-size: 15px; vertical-alignment: center; min-width: 44px; horizontal-alignment: center; }
                                    CuteButton { text: "＋"; primary: false; clicked => { root.desktop-limit-changed(root.desktop-limit + 1); } }
                                }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("隨機輪班"); }
                                    Hint { text: @tr("每隔一段時間，隨機和寵物窩裡的換班。"); }
                                }
                                Segmented {
                                    options: [@tr("不輪班"), @tr("30 分鐘"), @tr("1 小時"), @tr("3 小時")];
                                    selected <=> root.rotate;
                                    picked(i) => { root.rotate-picked(i); }
                                }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("大家的大小"); }
                                    Hint { text: @tr("一次調整所有寵物的大小。"); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    for choice in [{ label: @tr("小"), pct: 70 }, { label: @tr("中"), pct: 100 }, { label: @tr("大"), pct: 130 }, { label: @tr("特大"), pct: 160 }]: CuteButton {
                                        text: choice.label;
                                        primary: root.size-all == choice.pct;
                                        clicked => { root.size-all-picked(choice.pct); }
                                    }
                                }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("資料位置"); }
                                    Hint { text: root.data-path; }
                                }
                                CuteButton { text: @tr("打開資料夾"); primary: false; clicked => { root.open-folder(); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: @tr("移除所有痕跡"); }
                                    Hint { text: @tr("刪除開機自動啟動和應用程式選單的捷徑。之後結束肉肉賴桌、刪掉資料夾，就完全移除了。"); }
                                }
                                CuteButton { text: @tr("移除…"); primary: false; danger: true; clicked => { root.remove-traces(); } }
                            }
                        }
                    }
                    Text { text: @tr("肉肉賴桌 {}・不連網，不收集任何資料", root.version); color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                    // Attribution required by Slint's royalty-free licence.
                    HorizontalLayout {
                        alignment: center;
                        AboutSlint { max-width: 260px; }
                    }
                }
            }
        }
    }
}
