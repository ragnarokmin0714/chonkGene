// The settings window (PLAN §1.6–§1.11, mockup in §1.9).
// Labels are plain; the cuteness lives in hints and the pet's own lines.

import { LineEdit, ScrollView } from "std-widgets.slint";
import "../../../assets/fonts/jf-openhuninn-2.1.ttf";

export struct PetRow {
    id: string,
    name: string,
    dot: color,
    ring: color,
    resting: bool,
}

export struct CoatRow {
    id: string,
    label: string,
    main: color,
    light: color,
}

export struct SpeciesRow {
    id: string,
    label: string,
    blurb: string,
    portrait: image,
    tint: color,
}

global Theme {
    out property <color> bg: #FFF8EF;
    out property <color> side: #FFF0E0;
    out property <color> card: #FFFFFF;
    out property <color> ink: #4B3528;
    out property <color> muted: #7A6253;
    out property <color> line: #F0DFCC;
    out property <color> accent: #D9772F;
    out property <color> peach: #FFB37A;
    out property <color> peach-deep: #E08A4E;
    out property <color> track: #EADBCB;
    out property <color> hover: #FFEEDB;
    out property <color> danger: #B23B3B;
}

component Label inherits Text {
    color: Theme.ink;
    font-size: 15px;
    vertical-alignment: center;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

component PawSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 60px;
    height: 34px;
    border-radius: 17px;
    background: checked ? Theme.peach : Theme.track;
    animate background { duration: 250ms; }
    Rectangle {
        x: root.checked ? 29px : 3px;
        y: 3px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #4B352840;
        animate x { duration: 450ms; easing: cubic-bezier(0.3, 1.6, 0.5, 1.0); }
        property <color> pad: root.checked ? #F08C9A : #CDBBA9;
        Rectangle { x: 9px; y: 13px; width: 10px; height: 8px; border-radius: 4px; background: pad; }
        Rectangle { x: 5px; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 9px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 15px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
        Rectangle { x: 19px; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: pad; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component CuteButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    min-width: label.preferred-width + 36px;
    border-radius: 20px;
    background: !enabled ? Theme.track : primary ? (ta.pressed ? #F5A86E : Theme.peach) : (ta.pressed || ta.has-hover ? Theme.hover : Theme.card);
    border-width: primary ? 0px : 1.5px;
    border-color: danger ? #F2C4C4 : Theme.line;
    drop-shadow-blur: 0px;
    drop-shadow-offset-y: primary && enabled ? (ta.pressed ? 1px : 4px) : 0px;
    drop-shadow-color: Theme.peach-deep;
    animate drop-shadow-offset-y { duration: 120ms; }
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.muted : root.danger ? Theme.danger : Theme.ink;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A slider with a bone for a thumb that gets chunkier with `chonk`.
component BoneSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> chonk: 0.33;
    callback changed(float);
    height: 34px;
    min-width: 160px;
    horizontal-stretch: 1;
    property <float> t: (value - minimum) / (maximum - minimum);
    Rectangle {
        y: (parent.height - 12px) / 2;
        height: 12px;
        border-radius: 6px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 12px) / 2;
        width: root.t * (root.width - thumb.w) + thumb.w / 2;
        height: 12px;
        border-radius: 6px;
        background: Theme.peach;
    }
    thumb := Rectangle {
        property <length> w: 34px + 16px * root.chonk;
        width: w;
        height: 26px;
        x: root.t * (root.width - w);
        y: (root.height - 26px) / 2;
        // Bone: two knobs on each end joined by a bar, with an outline.
        Rectangle { x: 6px; y: 7px; width: parent.width - 12px; height: 12px; border-radius: 3px; background: white; border-width: 2px; border-color: Theme.peach-deep; }
        for k in [{x: 0, y: 0}, {x: 0, y: 1}, {x: 1, y: 0}, {x: 1, y: 1}]: Rectangle {
            x: k.x * (parent.width - 13px);
            y: k.y * 13px;
            width: 13px;
            height: 13px;
            border-radius: 6.5px;
            background: white;
            border-width: 2px;
            border-color: Theme.peach-deep;
        }
        Rectangle { x: 7px; y: 9px; width: parent.width - 14px; height: 8px; background: white; }
    }
    TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            root.value = root.minimum + max(0, min(1, (x - thumb.w / 2) / (root.width - thumb.w))) * (root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

/// A plain round-thumb slider for personality.
component MiniSlider inherits Rectangle {
    in-out property <float> value;
    callback changed(float);
    height: 26px;
    min-width: 100px;
    horizontal-stretch: 1;
    Rectangle { y: 9px; height: 8px; border-radius: 4px; background: Theme.track; }
    Rectangle { x: 0; y: 9px; width: root.value * (root.width - 22px) + 11px; height: 8px; border-radius: 4px; background: Theme.peach; }
    Rectangle {
        x: root.value * (root.width - 22px);
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        border-width: 4px;
        border-color: Theme.peach;
    }
    TouchArea {
        mouse-cursor: pointer;
        function set(x: length) {
            root.value = max(0, min(1, (x - 11px) / (root.width - 22px)));
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback picked(int);
    height: 44px;
    border-radius: 22px;
    background: Theme.track;
    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for label[i] in root.options: Rectangle {
            border-radius: 18px;
            background: i == root.selected ? Theme.card : transparent;
            min-width: t.preferred-width + 28px;
            t := Text {
                text: label;
                color: i == root.selected ? Theme.ink : Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 46px;
    border-radius: 16px;
    background: active ? Theme.card : ta.has-hover ? Theme.hover : transparent;
    drop-shadow-offset-y: active ? 3px : 0px;
    drop-shadow-color: Theme.line;
    HorizontalLayout {
        padding-left: 16px;
        Text {
            text: root.text;
            color: root.active ? Theme.ink : Theme.muted;
            font-size: 15px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Section inherits Rectangle {
    background: Theme.card;
    border-radius: 22px;
    border-width: 1.5px;
    border-color: Theme.line;
}

component Row inherits HorizontalLayout {
    padding-top: 14px;
    padding-bottom: 14px;
    spacing: 16px;
    alignment: space-between;
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 13px;
    font-weight: 600;
}

export component SettingsWindow inherits Window {
    title: "肉肉賴桌・設定";
    preferred-width: 880px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "jf-openhuninn-2.1";

    // Navigation.
    in-out property <int> tab: 0;

    // Pets.
    in property <[PetRow]> pets;
    in-out property <string> selected-pet;
    in property <bool> adopting;
    in property <[SpeciesRow]> species;
    in property <[CoatRow]> adopt-coats;
    in-out property <string> adopt-species;
    in-out property <string> adopt-coat;
    callback select-pet(string);
    callback start-adopting();
    callback pick-adopt-species(string);
    callback pick-adopt-coat(string);
    callback adopt();

    in property <string> species-label;
    in-out property <string> pet-name;
    in-out property <string> pet-you;
    in property <[CoatRow]> coats;
    in-out property <string> coat;
    in-out property <float> chonk;
    in-out property <float> size;
    in-out property <float> ticklish;
    in-out property <float> patience;
    in-out property <float> energy;
    in-out property <bool> on-desktop;
    in property <image> preview;
    in property <color> preview-tint;
    in property <string> preview-line;
    in property <string> level-text;
    in-out property <bool> confirm-release;
    callback name-edited(string);
    callback you-edited(string);
    callback coat-picked(string);
    callback chonk-changed(float);
    callback size-changed(float);
    callback trait-changed(int, float);
    callback desktop-toggled(bool);
    callback release();

    // Interaction & sound.
    in-out property <bool> sound;
    in-out property <float> volume;
    in-out property <bool> irrational;
    in-out property <int> squabble;
    callback sound-toggled(bool);
    callback volume-changed(float);
    callback irrational-toggled(bool);
    callback squabble-picked(int);

    // Don't disturb.
    in-out property <bool> hide-fullscreen;
    callback hide-fullscreen-toggled(bool);

    // General.
    in-out property <bool> start-login;
    in-out property <int> desktop-limit;
    in property <string> data-path;
    in property <string> notice;
    in property <string> version;
    callback start-login-toggled(bool);
    callback desktop-limit-changed(int);
    callback open-folder();
    callback remove-traces();

    HorizontalLayout {
        // Sidebar.
        Rectangle {
            width: 200px;
            background: Theme.side;
            VerticalLayout {
                padding: 14px;
                padding-top: 22px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-bottom: 12px;
                    Text { text: "肉肉賴桌"; color: Theme.accent; font-size: 18px; font-weight: 700; }
                }
                NavItem { text: "我的寵物"; active: root.tab == 0; clicked => { root.tab = 0; } }
                NavItem { text: "互動與聲音"; active: root.tab == 1; clicked => { root.tab = 1; } }
                NavItem { text: "不打擾"; active: root.tab == 2; clicked => { root.tab = 2; } }
                NavItem { text: "一般"; active: root.tab == 3; clicked => { root.tab = 3; } }
            }
        }

        ScrollView {
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                if root.notice != "": Rectangle {
                    background: #FDE2E2;
                    border-radius: 14px;
                    height: notice-text.preferred-height + 20px;
                    notice-text := Text {
                        x: 14px;
                        width: parent.width - 28px;
                        text: root.notice;
                        color: Theme.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // ── 我的寵物 ──
                if root.tab == 0: VerticalLayout {
                    spacing: 16px;
                    alignment: start;
                    Flickable {
                        height: 48px;
                        viewport-width: chips.preferred-width;
                        chips := HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            for p in root.pets: Rectangle {
                                height: 44px;
                                width: chip-text.preferred-width + 58px;
                                border-radius: 22px;
                                background: Theme.card;
                                border-width: 2px;
                                border-color: !root.adopting && p.id == root.selected-pet ? Theme.accent : Theme.line;
                                opacity: p.resting ? 0.6 : 1.0;
                                Rectangle {
                                    x: 8px;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: p.dot;
                                    Rectangle { y: 20px; height: 8px; border-radius: 4px; background: p.ring; }
                                }
                                chip-text := Text {
                                    x: 44px;
                                    text: p.name;
                                    color: Theme.ink;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-pet(p.id); }
                                }
                            }
                            Rectangle {
                                height: 44px;
                                width: add-text.preferred-width + 36px;
                                border-radius: 22px;
                                border-width: 2px;
                                border-color: root.adopting ? Theme.accent : Theme.line;
                                add-text := Text {
                                    text: "＋ 領養新寵物";
                                    color: Theme.muted;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.start-adopting(); }
                                }
                            }
                        }
                    }

                    // Adoption.
                    if root.adopting: VerticalLayout {
                        spacing: 14px;
                        Text { text: "挑一隻帶回你的桌面吧"; color: Theme.ink; font-size: 22px; }
                        GridLayout {
                            spacing: 12px;
                            for s[i] in root.species: Rectangle {
                                col: mod(i, 3);
                                row: floor(i / 3);
                                height: 196px;
                                border-radius: 22px;
                                background: Theme.card;
                                border-width: 2.5px;
                                border-color: s.id == root.adopt-species ? Theme.accent : Theme.line;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    Rectangle {
                                        height: 120px;
                                        border-radius: 16px;
                                        background: s.tint;
                                        Image { source: s.portrait; height: 112px; image-fit: contain; }
                                    }
                                    Text { text: s.label; color: Theme.ink; font-size: 17px; horizontal-alignment: center; }
                                    Text { text: s.blurb; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick-adopt-species(s.id); }
                                }
                            }
                        }
                        if root.adopt-species != "": HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Label { text: "毛色"; }
                            for c in root.adopt-coats: Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                border-width: c.id == root.adopt-coat ? 3px : 0px;
                                border-color: Theme.accent;
                                Rectangle {
                                    x: 5px; y: 5px; width: 30px; height: 30px; border-radius: 15px; background: c.main; border-width: 1px; border-color: #00000018;
                                    Rectangle { y: 22px; height: 8px; border-radius: 4px; background: c.light; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick-adopt-coat(c.id); }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            CuteButton {
                                text: root.adopt-species == "" ? "先選一隻吧" : "帶牠回家";
                                enabled: root.adopt-species != "";
                                clicked => { root.adopt(); }
                            }
                        }
                    }

                    // Editing the selected pet.
                    if !root.adopting && root.selected-pet != "": HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        Rectangle {
                            width: 240px;
                            height: 420px;
                            border-radius: 26px;
                            background: root.preview-tint;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                alignment: end;
                                Rectangle {
                                    height: bubble-text.preferred-height + 18px;
                                    border-radius: 18px;
                                    background: white;
                                    bubble-text := Text {
                                        text: root.preview-line;
                                        color: Theme.ink;
                                        font-size: 17px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Image { source: root.preview; height: 220px; image-fit: contain; }
                                Text { text: root.pet-name; color: Theme.ink; font-size: 22px; horizontal-alignment: center; }
                                Text { text: root.species-label + "・" + root.level-text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    Label { text: "名字"; }
                                    LineEdit {
                                        text <=> root.pet-name;
                                        edited(t) => { root.name-edited(t); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Label { text: "牠怎麼叫你"; }
                                    LineEdit {
                                        text <=> root.pet-you;
                                        edited(t) => { root.you-edited(t); }
                                    }
                                }
                            }
                            Hint { text: "牠在對話泡泡裡會這樣叫你。"; }

                            Label { text: "毛色"; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                for c in root.coats: VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 22px;
                                        border-width: c.id == root.coat ? 3px : 0px;
                                        border-color: Theme.accent;
                                        Rectangle {
                                            x: 5px; y: 5px; width: 34px; height: 34px; border-radius: 17px; background: c.main; border-width: 1px; border-color: #00000018;
                                            Rectangle { y: 25px; height: 9px; border-radius: 4.5px; background: c.light; }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.coat-picked(c.id); }
                                        }
                                    }
                                    Text { text: c.label; color: c.id == root.coat ? Theme.ink : Theme.muted; font-size: 12px; horizontal-alignment: center; }
                                }
                            }

                            Label { text: "體型"; }
                            BoneSlider {
                                value <=> root.chonk;
                                chonk: root.chonk;
                                changed(v) => { root.chonk-changed(v); }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                for stop[i] in ["標準", "略肥（預設）", "圓滾滾", "麻糬"]: Text {
                                    text: stop;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.chonk = [0.0, 0.33, 0.66, 1.0][i];
                                            root.chonk-changed(root.chonk);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Label { text: "大小"; }
                                Text { text: round(root.size * 100) + "%"; color: Theme.muted; font-size: 14px; }
                            }
                            BoneSlider {
                                value <=> root.size;
                                minimum: 0.5;
                                maximum: 2.0;
                                chonk: 0.2;
                                changed(v) => { root.size-changed(v); }
                            }
                            Hint { text: "牠在桌面上看起來有多大。"; }

                            Label { text: "個性"; }
                            for t[i] in [{label: "怕癢", lo: "不怕", hi: "超怕"}, {label: "耐性", lo: "沒耐性", hi: "很有耐性"}, {label: "活潑", lo: "懶洋洋", hi: "停不下來"}]: HorizontalLayout {
                                spacing: 8px;
                                Text { text: t.label; width: 40px; color: Theme.ink; font-size: 14px; vertical-alignment: center; }
                                Text { text: t.lo; width: 52px; color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                MiniSlider {
                                    value: i == 0 ? root.ticklish : i == 1 ? root.patience : root.energy;
                                    changed(v) => { root.trait-changed(i, v); }
                                }
                                Text { text: t.hi; width: 64px; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                            }
                            Hint { text: "會影響被戳的時候，是翻肚爆笑還是一臉厭世。"; }

                            Section {
                                height: 76px;
                                Row {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Label { text: "在桌面上"; }
                                        Hint { text: "關掉的話，牠會在寵物窩休息。"; }
                                    }
                                    PawSwitch {
                                        checked <=> root.on-desktop;
                                        toggled(v) => { root.desktop-toggled(v); }
                                    }
                                }
                            }

                            if !root.confirm-release: HorizontalLayout {
                                alignment: end;
                                CuteButton {
                                    text: "說再見…";
                                    primary: false;
                                    danger: true;
                                    clicked => { root.confirm-release = true; }
                                }
                            }
                            if root.confirm-release: Section {
                                height: 120px;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    Label { text: "確定要和" + root.pet-name + "說再見嗎？"; }
                                    Hint { text: "牠的名字和親密度會一起消失。"; }
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 10px;
                                        CuteButton { text: "再想想"; primary: false; clicked => { root.confirm-release = false; } }
                                        CuteButton { text: "說再見"; primary: false; danger: true; clicked => { root.release(); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── 互動與聲音 ──
                if root.tab == 1: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "互動與聲音"; color: Theme.ink; font-size: 24px; }
                    SectionTitle { text: "聲音"; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "聲音模式"; }
                                    Hint { text: "讓牠們叫、笑、打呼。全螢幕時會自動安靜。"; }
                                }
                                PawSwitch { checked <=> root.sound; toggled(v) => { root.sound-toggled(v); } }
                            }
                            Row {
                                Label { text: "音量"; width: 80px; }
                                BoneSlider {
                                    value <=> root.volume;
                                    chonk: 0.1;
                                    changed(v) => { root.volume-changed(v); }
                                }
                                Text { text: round(root.volume * 100) + "%"; width: 48px; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                    }
                    SectionTitle { text: "非理性模式"; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "非理性模式"; }
                                    Hint { text: "兩隻以上時，偶爾會為了小事吵起來，最後一定和好。點吵架中的任何一隻可以勸架。"; }
                                }
                                PawSwitch { checked <=> root.irrational; toggled(v) => { root.irrational-toggled(v); } }
                            }
                            Row {
                                Label { text: "吵架頻率"; }
                                Segmented {
                                    options: ["偶爾", "常常", "超常"];
                                    selected <=> root.squabble;
                                    picked(i) => { root.squabble-picked(i); }
                                }
                            }
                        }
                    }
                }

                // ── 不打擾 ──
                if root.tab == 2: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "不打擾"; color: Theme.ink; font-size: 24px; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "全螢幕時躲起來"; }
                                    Hint { text: "看影片、玩遊戲或簡報時，牠們會先躲起來，結束後再回來。"; }
                                }
                                PawSwitch { checked <=> root.hide-fullscreen; toggled(v) => { root.hide-fullscreen-toggled(v); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "一鍵收起來"; }
                                    Hint { text: "再按一次就叫回來。"; }
                                }
                                Text { text: "Ctrl + Alt + P"; color: Theme.ink; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // ── 一般 ──
                if root.tab == 3: VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "一般"; color: Theme.ink; font-size: 24px; }
                    Section {
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "開機時一起醒來"; }
                                    Hint { text: "電腦開機後，牠們會自動出現在桌面上。"; }
                                }
                                PawSwitch { checked <=> root.start-login; toggled(v) => { root.start-login-toggled(v); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "同時在桌面上的寵物"; }
                                    Hint { text: root.desktop-limit > 6 ? "寵物越多，用的電腦資源也越多。" : "其他的會在寵物窩休息。"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    CuteButton { text: "－"; primary: false; enabled: root.desktop-limit > 1; clicked => { root.desktop-limit-changed(root.desktop-limit - 1); } }
                                    Text { text: root.desktop-limit + " 隻"; color: Theme.ink; font-size: 15px; vertical-alignment: center; min-width: 44px; horizontal-alignment: center; }
                                    CuteButton { text: "＋"; primary: false; clicked => { root.desktop-limit-changed(root.desktop-limit + 1); } }
                                }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "資料位置"; }
                                    Hint { text: root.data-path; }
                                }
                                CuteButton { text: "打開資料夾"; primary: false; clicked => { root.open-folder(); } }
                            }
                            Row {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Label { text: "移除所有痕跡"; }
                                    Hint { text: "刪除開機自動啟動。之後結束肉肉賴桌、刪掉資料夾，就完全移除了。"; }
                                }
                                CuteButton { text: "移除…"; primary: false; danger: true; clicked => { root.remove-traces(); } }
                            }
                        }
                    }
                    Text { text: "肉肉賴桌 " + root.version + "・不連網，不收集任何資料"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                }
            }
        }
    }
}
